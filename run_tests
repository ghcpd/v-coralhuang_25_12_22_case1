#!/usr/bin/env python3
"""Simple test runner that runs pytest and prints PASS/FAIL summary.

Usage: python run_tests
"""
import subprocess
import sys

cmd = [sys.executable, "-m", "pytest", "-q"]
print("Running tests: ", " ".join(cmd))
proc = subprocess.run(cmd)
if proc.returncode == 0:
    print("\n✅ ALL TESTS PASSED")
else:
    print("\n❌ SOME TESTS FAILED (exit code {})".format(proc.returncode))

sys.exit(proc.returncode)
