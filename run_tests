#!/usr/bin/env python
"""One-command test runner — installs deps (if needed) and runs pytest.

Usage: python run_tests
"""
import sys
import subprocess

try:
    import pytest
except Exception:
    print("pytest not found — installing requirements.txt...")
    rc = subprocess.call([sys.executable, "-m", "pip", "install", "-r", "requirements.txt"])
    if rc != 0:
        print("failed to install requirements")
        sys.exit(rc)

# Run pytest
ret = subprocess.call([sys.executable, "-m", "pytest", "-q"]) 
if ret == 0:
    print("\n✅ ALL TESTS PASSED")
else:
    print("\n❌ SOME TESTS FAILED")
sys.exit(ret)
